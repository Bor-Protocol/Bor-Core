{
    "name": "ai-khwarizmi",
    "scripts": {
        "build": "cd packages/core && npx tsup --format esm --dts",
        "start": "cd packages/agent && npm start",
        "start:railway": "cross-env TS_NODE_TRANSPILE_ONLY=true node --loader ts-node/esm packages/agent/src/index.ts",
        "test:env": "node test-env.js",
        "dev": "cd packages/agent && npm run dev",
        "lint": "cd packages/core && npm run lint && cd ../agent && npm run lint",
        "prettier-check": "npx prettier --check .",
        "prettier": "npx prettier --write .",
        "postinstall": "cd packages/core && npm install && cd ../agent && npm install"
    },
    "devDependencies": {
        "concurrently": "^9.1.0",
        "husky": "^9.1.6",
        "lerna": "^8.1.5",
        "only-allow": "^1.2.1",
        "prettier": "^3.3.3",
        "typedoc": "^0.26.11",
        "typescript": "5.6.3"
    },
    "engines": {
        "node": ">=22"
    },
    "dependencies": {
        "@elevenlabs/elevenlabs-js": "^2.10.0",
        "cross-env": "^7.0.3",
        "ollama-ai-provider": "^0.16.1",
        "optional": "^0.1.4",
        "sharp": "^0.33.5",
        "ts-node": "10.9.2",
        "typescript": "5.6.3"
    }
}
