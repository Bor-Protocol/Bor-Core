{
    "name": "ai-khwarizmi",
    "scripts": {
        "build": "cd packages/core && npx tsup --format esm --dts && cd ../agent && npx tsup src/index.ts --format esm --dts",
        "start": "cd packages/agent && npm start",
        "dev": "cd packages/agent && npm run dev",
        "lint": "cd packages/core && npm run lint && cd ../agent && npm run lint",
        "prettier-check": "npx prettier --check .",
        "prettier": "npx prettier --write .",
        "postinstall": "cd packages/core && npm install && cd ../agent && npm install"
    },
    "devDependencies": {
        "concurrently": "^9.1.0",
        "husky": "^9.1.6",
        "lerna": "^8.1.5",
        "only-allow": "^1.2.1",
        "prettier": "^3.3.3",
        "typedoc": "^0.26.11",
        "typescript": "5.6.3"
    },
    "pnpm": {
        "overrides": {
            "onnxruntime-node": "^1.20.0"
        }
    },
    "engines": {
        "node": ">=22"
    },
    "dependencies": {
        "ollama-ai-provider": "^0.16.1",
        "optional": "^0.1.4",
        "sharp": "^0.33.5"
    }
}
